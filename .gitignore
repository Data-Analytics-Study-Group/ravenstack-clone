# =========================
# Data
# =========================

# Personal workspace for each developer
personal/

# Raw source data (CSV, Excel, JSON, Parquet, database exports).
# Files in this folder are not tracked by Git.
data/raw/*
!data/raw/.gitkeep

# Intermediate datasets generated during processing.
# Files in this folder are not tracked by Git.
data/interim/*
!data/interim/.gitkeep

# Local processed datasets.
# Processed data should be stored in Neon, not committed to Git.
data/processed/*
!data/processed/.gitkeep

# =========================
# Jupyter
# =========================

.ipynb_checkpoints/

# =========================
# Python
# =========================

__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/


# =========================
# Environment variables
# =========================

.env
.env.*
!.env.example

# =========================
# IDEs
# =========================

.vscode/
.idea/

# =========================
# Logs
# =========================

*.log

# =========================
# ML Artifacts
# =========================

# Trained models and ML artifacts.
# Files in this folder are not tracked by Git.
models/*
!models/.gitkeep

