-- THIS SQL File will create the 5 tables and establish the relationship between them
-- Date : 2026-06-03
-- Created By : Chaker Saidi

CREATE TABLE IF NOT EXISTS accounts(
account_id TEXT PRIMARY KEY,
account_name TEXT NOT NULL,
industry TEXT,
country CHAR(2),
signup_date DATE,
referral_source TEXT,
plan_tier TEXT,
seats INTEGER,
is_trial BOOLEAN DEFAULT FALSE,
churn_flag BOOLEAN DEFAULT FALSE
);
CREATE TABLE IF NOT EXISTS events (
    churn_event_id TEXT PRIMARY KEY,
    account_id TEXT NOT NULL,
    churn_date DATE,
    reason_code TEXT,
    refund_amount_usd NUMERIC(10,2),
    preceding_upgrade_flag BOOLEAN,
    preceding_downgrade_flag BOOLEAN,
    is_reactivation BOOLEAN,
    feedback_text TEXT,

    CONSTRAINT fk_account
        FOREIGN KEY (account_id)
        REFERENCES accounts(account_id)
);

CREATE TABLE IF NOT EXISTS feature_usage (
    usage_id TEXT PRIMARY KEY,
    subscription_id TEXT NOT NULL,
    usage_date DATE,
    feature_name TEXT,
    usage_count INTEGER,
    usage_duration_secs INTEGER,
    error_count INTEGER,
    is_beta_feature BOOLEAN,

    CONSTRAINT fk_subscription
        FOREIGN KEY (subscription_id)
        REFERENCES subscriptions(subscription_id)
);
CREATE TABLE IF NOT EXISTS subscriptions (
    subscription_id TEXT PRIMARY KEY,
    account_id TEXT NOT NULL,
    start_date DATE,
    end_date DATE,
    plan_tier TEXT,
    seats INTEGER,
    mrr_amount NUMERIC(10,2),
    arr_amount NUMERIC(12,2),
    is_trial BOOLEAN,
    upgrade_flag BOOLEAN,
    downgrade_flag BOOLEAN,
    churn_flag BOOLEAN,
    billing_frequency TEXT,
    auto_renew_flag BOOLEAN,

    CONSTRAINT fk_account
        FOREIGN KEY (account_id)
        REFERENCES accounts(account_id)
);

CREATE TABLE IF NOT EXISTS support_tickets (
    ticket_id TEXT PRIMARY KEY,
    account_id TEXT NOT NULL,
    submitted_at TIMESTAMP,
    closed_at TIMESTAMP,
    resolution_time_hours NUMERIC(8,2),
    priority TEXT,
    first_response_time_minutes INTEGER,
    satisfaction_score INTEGER,
    escalation_flag BOOLEAN,

    CONSTRAINT fk_account
        FOREIGN KEY (account_id)
        REFERENCES accounts(account_id)
);